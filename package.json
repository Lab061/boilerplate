{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "undeploy": "sst remove",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -b packages/core packages/functions packages/frontend",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --deny-warnings",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.5.3",
    "sst": "^4.17.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
